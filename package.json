{
  "name": "generador_de_contrasenas",
  "version": "1.0.0",
  "description": "Generador de contraseñas criptográficamente seguras con análisis de entropía",
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude \"e2e/**\"",
    "bench": "node generator.bench.js",
